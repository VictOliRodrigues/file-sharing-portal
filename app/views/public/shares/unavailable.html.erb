<% content_for :title, "Link unavailable" %>

<div class="card mx-auto max-w-md px-6 py-12 text-center">
  <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
    <%= inline_icon :lock, css_class: "h-6 w-6" %>
  </span>
  <h1 class="mt-4 text-lg font-semibold text-slate-900">This link is not available</h1>
  <p class="mt-2 text-sm text-slate-500">
    It may have expired, reached its download limit, or been revoked by its
    owner. Ask whoever shared it with you for a new link.
  </p>
</div>
