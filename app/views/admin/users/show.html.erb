<% content_for :title, @user.name %>

<div class="mx-auto max-w-3xl space-y-6">
  <div class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 class="truncate text-lg font-semibold text-slate-900"><%= @user.name %></h2>
        <p class="mt-1 truncate text-sm text-slate-500"><%= @user.email_address %></p>
      </div>
      <div class="flex flex-wrap gap-1">
        <% if @user.admin? %>
          <span class="badge bg-indigo-100 text-indigo-800">Admin</span>
        <% end %>
        <% if @user.disabled? %>
          <span class="badge bg-red-100 text-red-800">Disabled</span>
        <% else %>
          <span class="badge bg-emerald-100 text-emerald-800">Active</span>
        <% end %>
      </div>
    </div>

    <dl class="mt-6 grid grid-cols-1 gap-4 border-t border-slate-200 pt-6 sm:grid-cols-3">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Storage used</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= human_size(@user.storage_used) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Quota</dt>
        <dd class="mt-1 text-sm text-slate-900">
          <%= @user.storage_quota ? human_size(@user.storage_quota) : "Unlimited" %>
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Joined</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= l @user.created_at.to_date, format: :long %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Files</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @user.stored_files.kept.count %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Share links</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @user.share_links.count %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">Last signed in</dt>
        <dd class="mt-1 text-sm text-slate-900">
          <%= @user.last_signed_in_at ? "#{time_ago_in_words(@user.last_signed_in_at)} ago" : "Never" %>
        </dd>
      </div>
    </dl>
  </div>

  <div class="card p-6">
    <h3 class="text-base font-semibold text-slate-900">Account settings</h3>
    <p class="mt-1 text-sm text-slate-500">
      Names, addresses and passwords stay under the control of the account holder.
    </p>

    <%= form_with model: @user, url: admin_user_path(@user), method: :patch,
          class: "mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2" do |form| %>
      <div>
        <%= form.label :storage_quota_bytes, "Storage quota in bytes", class: "form-label" %>
        <%= form.number_field :storage_quota_bytes, min: 0, class: "form-input",
              placeholder: "Server default" %>
        <p class="form-hint">Enter 0 for unlimited, or leave empty for the server default.</p>
      </div>
      <div class="flex items-end">
        <div class="flex items-center gap-2 pb-2">
          <%= form.check_box :admin, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
          <%= form.label :admin, "Administrator", class: "text-sm text-slate-700" %>
        </div>
      </div>
      <div class="sm:col-span-2 flex justify-end">
        <%= form.submit "Save", class: "btn-secondary" %>
      </div>
    <% end %>
  </div>

  <div class="card p-6">
    <h3 class="text-base font-semibold text-slate-900">Recent files</h3>
    <% if @stored_files.any? %>
      <ul class="mt-4 divide-y divide-slate-100">
        <% @stored_files.each do |stored_file| %>
          <li class="flex items-center justify-between gap-4 py-2 text-sm">
            <span class="truncate text-slate-700"><%= stored_file.name %></span>
            <span class="shrink-0 text-slate-500"><%= human_size(stored_file.byte_size) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-sm text-slate-500">This account has not uploaded anything.</p>
    <% end %>
  </div>

  <% if @user != current_user %>
    <div class="card p-6">
      <h3 class="text-base font-semibold text-slate-900">Danger zone</h3>
      <p class="mt-1 text-sm text-slate-500">
        Disabling signs the account out everywhere and blocks new sign ins, but
        keeps every file. Deleting removes the account together with all of its
        folders, files and share links.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <% if @user.disabled? %>
          <%= button_to "Enable account", enable_admin_user_path(@user), method: :post,
                class: "btn-secondary" %>
        <% else %>
          <%= button_to "Disable account", disable_admin_user_path(@user), method: :post,
                class: "btn-secondary",
                form: { data: { turbo_confirm: "Disable #{@user.name}?" } } %>
        <% end %>
        <%= button_to "Delete account", admin_user_path(@user), method: :delete, class: "btn-danger",
              form: { data: { turbo_confirm: "Permanently delete #{@user.name} and every file they own? This cannot be undone." } } %>
      </div>
    </div>
  <% end %>

  <div>
    <%= link_to "Back to users", admin_users_path, class: "btn-ghost" %>
  </div>
</div>
