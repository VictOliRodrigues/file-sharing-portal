<% if flash.any? %>
  <div class="mb-6 space-y-3" role="status" aria-live="polite">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div class="rounded-lg px-4 py-3 text-sm ring-1 ring-inset <%= flash_classes(type) %>">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>
