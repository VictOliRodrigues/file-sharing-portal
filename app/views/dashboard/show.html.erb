<% content_for :title, "Dashboard" %>

<div class="space-y-6">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "dashboard/stat", label: "Files", value: @total_files, icon: :files,
          detail: "#{pluralize(@trashed_files, 'file')} in the trash" %>
    <%= render "dashboard/stat", label: "Storage used", value: human_size(@storage_used), icon: :storage,
          detail: @storage_quota ? "of #{human_size(@storage_quota)}" : "No quota set" %>
    <%= render "dashboard/stat", label: "Downloads", value: current_user.stored_files.sum(:download_count),
          icon: :download, detail: "across all your files" %>
    <%= render "dashboard/stat", label: "Uploaded this week", icon: :upload,
          value: current_user.stored_files.kept.where(created_at: 1.week.ago..).count,
          detail: "in the last 7 days" %>
  </div>

  <% if @storage_quota %>
    <div class="card p-6">
      <div class="flex items-center justify-between text-sm">
        <span class="font-medium text-slate-700">Storage quota</span>
        <span class="text-slate-500">
          <%= human_size(@storage_used) %> of <%= human_size(@storage_quota) %>
        </span>
      </div>
      <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-slate-200">
        <div class="h-full rounded-full bg-indigo-600"
             style="width: <%= current_user.storage_used_percentage %>%"></div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section class="card">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
        <h2 class="text-base font-semibold text-slate-900">Recent uploads</h2>
        <%= link_to "View all", files_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
      </div>
      <% if @recent_uploads.any? %>
        <ul class="divide-y divide-slate-100">
          <% @recent_uploads.each do |stored_file| %>
            <li class="flex items-center justify-between gap-4 px-6 py-3">
              <div class="min-w-0">
                <%= link_to stored_file.name, file_path(stored_file),
                      class: "block truncate text-sm font-medium text-slate-900 hover:text-indigo-600" %>
                <p class="text-xs text-slate-500"><%= human_size(stored_file.byte_size) %></p>
              </div>
              <span class="shrink-0 text-xs text-slate-500">
                <%= time_ago_in_words(stored_file.created_at) %> ago
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-6 py-8 text-center text-sm text-slate-500">Nothing uploaded yet.</p>
      <% end %>
    </section>

    <section class="card">
      <div class="border-b border-slate-200 px-6 py-4">
        <h2 class="text-base font-semibold text-slate-900">Recent downloads</h2>
      </div>
      <% if @recent_downloads.any? %>
        <ul class="divide-y divide-slate-100">
          <% @recent_downloads.each do |download| %>
            <li class="flex items-center justify-between gap-4 px-6 py-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-slate-900"><%= download.stored_file.name %></p>
                <p class="text-xs text-slate-500">
                  <%= download.anonymous? ? "Share link visitor" : download.user.name %>
                </p>
              </div>
              <span class="shrink-0 text-xs text-slate-500">
                <%= time_ago_in_words(download.created_at) %> ago
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="px-6 py-8 text-center text-sm text-slate-500">No downloads recorded yet.</p>
      <% end %>
    </section>
  </div>
</div>
