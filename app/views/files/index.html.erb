<% content_for :title, "Files" %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-base font-semibold text-slate-900">Your files</h2>
      <p class="mt-1 text-sm text-slate-500">
        <%= pluralize(@stored_files.size, "file") %> ·
        <%= human_size(current_user.storage_used) %> stored
      </p>
    </div>
    <%= link_to new_file_path, class: "btn-primary" do %>
      <%= inline_icon :upload %> Upload files
    <% end %>
  </div>

  <% if @stored_files.any? %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="table-header">Name</th>
              <th class="table-header">Size</th>
              <th class="table-header hidden sm:table-cell">Type</th>
              <th class="table-header hidden md:table-cell">Uploaded</th>
              <th class="table-header hidden md:table-cell">Downloads</th>
              <th class="table-header"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <%= render partial: "files/file_row", collection: @stored_files, as: :stored_file %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <%= render "files/empty_state" %>
  <% end %>
</div>
