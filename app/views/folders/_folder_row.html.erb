<tr id="<%= dom_id(folder) %>" class="hover:bg-slate-50">
  <td class="table-cell">
    <div class="flex items-center gap-3">
      <span class="text-indigo-500"><%= inline_icon :folder %></span>
      <%= link_to folder.name, folder_path(folder),
            class: "block max-w-xs truncate font-medium text-slate-900 hover:text-indigo-600",
            title: folder.name %>
    </div>
  </td>
  <td class="table-cell whitespace-nowrap"><%= human_size(folder.total_byte_size) %></td>
  <td class="table-cell hidden sm:table-cell">
    <span class="badge bg-indigo-50 text-indigo-700">folder</span>
  </td>
  <td class="table-cell hidden whitespace-nowrap md:table-cell">
    <%= time_ago_in_words(folder.created_at) %> ago
  </td>
  <td class="table-cell hidden md:table-cell">--</td>
  <td class="table-cell">
    <div class="flex items-center justify-end gap-1">
      <%= button_to folder_path(folder), method: :delete, class: "btn-ghost", title: "Move to trash",
            form: { data: { turbo_confirm: "Move #{folder.name} and everything inside it to the trash?" } } do %>
        <%= inline_icon :trash %><span class="sr-only">Move to trash</span>
      <% end %>
    </div>
  </td>
</tr>
