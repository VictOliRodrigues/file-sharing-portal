<% content_for :title, "Search" %>

<div class="space-y-6">
  <section class="card p-6">
    <h2 class="text-base font-semibold text-slate-900">Search your drive</h2>

    <%= form_with url: search_path, method: :get, class: "mt-4 grid grid-cols-1 gap-4 sm:grid-cols-4" do |form| %>
      <div class="sm:col-span-2">
        <%= form.label :q, "File name", class: "form-label" %>
        <%= form.search_field :q, value: @search.term, autofocus: true,
              placeholder: "Part of a name", class: "form-input" %>
      </div>

      <div>
        <%= form.label :folder_id, "Folder", class: "form-label" %>
        <%= form.collection_select :folder_id, @folder_options, :id, :name,
              { include_blank: "Anywhere", selected: @folder&.id }, class: "form-select" %>
        <p class="form-hint">Includes subfolders.</p>
      </div>

      <div>
        <%= form.label :type, "File type", class: "form-label" %>
        <%= form.select :type,
              options_for_select(FileSearch::CATEGORIES.map { |name| [ name.capitalize, name ] },
                                 @search.category),
              { include_blank: "Any type" }, class: "form-select" %>
      </div>

      <div class="sm:col-span-4 flex justify-end gap-3">
        <%= link_to "Clear", search_path, class: "btn-secondary" %>
        <%= form.submit "Search", class: "btn-primary" %>
      </div>
    <% end %>
  </section>

  <% if @search.filtered? %>
    <div>
      <h3 class="text-sm font-medium text-slate-700">
        <%= pluralize(@folders.size + @stored_files.size, "result") %>
      </h3>
    </div>

    <% if @folders.any? || @stored_files.any? %>
      <div class="card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200">
            <thead class="bg-slate-50">
              <tr>
                <th class="table-header">Name</th>
                <th class="table-header hidden sm:table-cell">Location</th>
                <th class="table-header">Size</th>
                <th class="table-header hidden md:table-cell">Type</th>
                <th class="table-header"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <% @folders.each do |folder| %>
                <tr class="hover:bg-slate-50">
                  <td class="table-cell">
                    <div class="flex items-center gap-3">
                      <span class="text-indigo-500"><%= inline_icon :folder %></span>
                      <%= link_to folder.name, folder_path(folder),
                            class: "block max-w-xs truncate font-medium text-slate-900 hover:text-indigo-600" %>
                    </div>
                  </td>
                  <td class="table-cell hidden sm:table-cell">
                    <%= folder.parent ? folder.parent.name : "All files" %>
                  </td>
                  <td class="table-cell">--</td>
                  <td class="table-cell hidden md:table-cell">
                    <span class="badge bg-indigo-50 text-indigo-700">folder</span>
                  </td>
                  <td class="table-cell"></td>
                </tr>
              <% end %>

              <% @stored_files.each do |stored_file| %>
                <tr class="hover:bg-slate-50">
                  <td class="table-cell">
                    <div class="flex items-center gap-3">
                      <span class="text-slate-400"><%= inline_icon :files %></span>
                      <%= link_to stored_file.name, file_path(stored_file),
                            class: "block max-w-xs truncate font-medium text-slate-900 hover:text-indigo-600" %>
                    </div>
                  </td>
                  <td class="table-cell hidden sm:table-cell">
                    <% if stored_file.folder %>
                      <%= link_to stored_file.folder.name, folder_path(stored_file.folder),
                            class: "hover:text-indigo-600" %>
                    <% else %>
                      All files
                    <% end %>
                  </td>
                  <td class="table-cell whitespace-nowrap"><%= human_size(stored_file.byte_size) %></td>
                  <td class="table-cell hidden md:table-cell">
                    <span class="badge bg-slate-100 text-slate-700"><%= stored_file.category %></span>
                  </td>
                  <td class="table-cell text-right">
                    <%= link_to download_file_path(stored_file), class: "btn-ghost", title: "Download" do %>
                      <%= inline_icon :download %><span class="sr-only">Download</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="card px-6 py-16 text-center">
        <h3 class="text-sm font-semibold text-slate-900">Nothing matched</h3>
        <p class="mt-1 text-sm text-slate-500">Try a shorter name, or widen the filters.</p>
      </div>
    <% end %>
  <% end %>
</div>
