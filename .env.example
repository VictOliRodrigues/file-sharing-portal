# ---------------------------------------------------------------------------
# File Sharing Portal -- example environment file
#
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and
# must never be committed.
#
#   cp .env.example .env
#
# Generate a strong secret with:
#
#   docker compose run --rm web bin/rails secret
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------

# Name shown in the interface and in outgoing emails.
APP_NAME="File Sharing Portal"

# Public hostname of the deployment. Used to build absolute URLs in emails and
# share links. Do not include the scheme.
APP_HOST=files.example.com

RAILS_ENV=production

# REQUIRED in production. Must be a long random string, unique per deployment.
# Rotating it invalidates every session, password reset link and signed cookie.
SECRET_KEY_BASE=replace-me-with-the-output-of-bin-rails-secret

# Number of database connections and request threads per process.
RAILS_MAX_THREADS=5

# Number of Puma worker processes. Keep 0 (single process, multi-threaded)
# unless REDIS_URL is configured, so rate limit counters stay shared.
WEB_CONCURRENCY=0

TIME_ZONE=UTC
RAILS_LOG_LEVEL=info

# --- TLS and host protection ------------------------------------------------

# Redirect HTTP to HTTPS and enable HSTS. Set to false only when the portal is
# served over plain HTTP inside a trusted private network.
FORCE_SSL=true

# Trust X-Forwarded-Proto from the reverse proxy that terminates TLS.
ASSUME_SSL=true

# Comma separated allowlist for the Host header (DNS rebinding protection).
# Leave empty to accept any host.
ALLOWED_HOSTS=

# --- Database ---------------------------------------------------------------

# Preferred: a single connection string. Overrides the POSTGRES_* values below.
DATABASE_URL=postgresql://portal:change-me@db:5432/file_sharing_portal_production

# Used when DATABASE_URL is not set.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=file_sharing_portal_production

# --- File storage -----------------------------------------------------------

# `local` stores files on disk, `s3` on any S3-compatible object store.
ACTIVE_STORAGE_SERVICE=local

# Where the local disk service writes files. Mount this path on a volume so
# uploads survive container restarts.
STORAGE_PATH=/rails/storage

# Only needed when ACTIVE_STORAGE_SERVICE=s3.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for non-AWS providers such as MinIO, Cloudflare R2, Backblaze B2 or Wasabi.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true

# --- Upload limits and policy ----------------------------------------------

# Largest accepted single upload, in megabytes.
MAX_UPLOAD_SIZE_MB=512

# Per-user storage quota in megabytes. 0 means unlimited.
DEFAULT_STORAGE_QUOTA_MB=0

# Allow visitors to create their own account. Set to false for an invite-only
# or admin-provisioned deployment.
ALLOW_REGISTRATION=true

# Longest allowed lifetime for a share link, in days. 0 means no upper bound.
MAX_SHARE_LINK_DAYS=0

# --- Email ------------------------------------------------------------------

# Address used as the sender for password reset messages.
MAIL_FROM=no-reply@example.com

# Leave SMTP_ADDRESS empty to log emails instead of delivering them.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true

# --- Security ---------------------------------------------------------------

RATE_LIMIT_ENABLED=true

# Requests allowed per IP address per 5 minutes before throttling kicks in.
RATE_LIMIT_REQUESTS=300

# Report Content Security Policy violations without enforcing them.
CSP_REPORT_ONLY=false

# --- Optional shared cache --------------------------------------------------

# Required only when running more than one Puma worker or container, so that
# rate limit counters are shared between processes.
REDIS_URL=

# --- First administrator ----------------------------------------------------

# Used by `bin/rails db:seed` to create the initial administrator account.
# Remove these values once the account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Upload type policy -----------------------------------------------------

# Comma separated file extensions. When ALLOWED is empty every extension is
# accepted; BLOCKED always wins. Both are empty by default because a general
# purpose portal has to accept arbitrary files.
#
#   UPLOAD_ALLOWED_EXTENSIONS=pdf,png,jpg,docx
#   UPLOAD_BLOCKED_EXTENSIONS=exe,bat,cmd,scr
UPLOAD_ALLOWED_EXTENSIONS=
UPLOAD_BLOCKED_EXTENSIONS=

# --- Maintenance ------------------------------------------------------------

# Used by `bin/rails portal:purge_trash`, which is meant to be run from cron.
# Items deleted longer ago than this are removed for good. 0 disables automatic
# purging, leaving the trash entirely under user control.
TRASH_RETENTION_DAYS=30
