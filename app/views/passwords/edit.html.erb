<% content_for :title, "Choose a new password" %>

<div class="card p-8">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-semibold text-slate-900">Choose a new password</h1>
    <p class="mt-1 text-sm text-slate-500">Signing you out of every other device.</p>
  </div>

  <%= form_with model: @user, url: password_path(params[:token]), method: :patch, class: "space-y-5" do |form| %>
    <%= form_errors_for @user %>

    <div>
      <%= form.label :password, "New password", class: "form-label" %>
      <%= form.password_field :password, required: true, autofocus: true,
            autocomplete: "new-password", class: "form-input" %>
      <p class="form-hint">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
      <%= form.password_field :password_confirmation, required: true,
            autocomplete: "new-password", class: "form-input" %>
    </div>

    <%= form.submit "Save new password", class: "btn-primary w-full" %>
  <% end %>
</div>
