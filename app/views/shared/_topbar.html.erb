<header class="flex items-center justify-between gap-4 border-b border-slate-200 bg-white px-4 py-3 sm:px-6 lg:px-8">
  <div class="min-w-0 flex-1">
    <h1 class="truncate text-lg font-semibold text-slate-900 lg:hidden">
      <%= content_for(:title) || "Dashboard" %>
    </h1>
    <%= form_with url: search_path, method: :get, class: "hidden max-w-sm lg:block" do |form| %>
      <label for="topbar-search" class="sr-only">Search files</label>
      <div class="relative">
        <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
          <%= inline_icon :search, css_class: "h-4 w-4" %>
        </span>
        <%= form.search_field :q, id: "topbar-search", placeholder: "Search files and folders",
              class: "form-input pl-9" %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to search_path, class: "btn-ghost lg:hidden", title: "Search" do %>
      <%= inline_icon :search %><span class="sr-only">Search</span>
    <% end %>
    <div class="hidden text-right sm:block">
      <p class="text-sm font-medium text-slate-900"><%= current_user.name %></p>
      <p class="text-xs text-slate-500"><%= current_user.email_address %></p>
    </div>
    <%= button_to sign_out_path, method: :delete, class: "btn-ghost", title: "Sign out" do %>
      <%= inline_icon :signout %>
      <span class="sr-only">Sign out</span>
    <% end %>
  </div>
</header>
